# Copy to .env.local for local dev, or add these under Vercel → Settings → Environment Variables.

# Public site URL, used for OG tags, sitemap and canonical URLs
NEXT_PUBLIC_SITE_URL=https://kaashi-weaves.vercel.app

# WhatsApp number for orders: country code + number, digits only.
# Leave empty to keep the site in concept mode (ordering disabled).
NEXT_PUBLIC_WHATSAPP_NUMBER=
